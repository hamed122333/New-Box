# Hébergement Apache (cPanel, Plesk…) : déposer le contenu de dist/ à la racine du site.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS et domaine sans www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://newbox.com.tn%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # fichiers empreintés par Vite (dossier assets/) : cache long ; les fichiers de public/
  # (apple-touch-icon.png, icon-192.png…) gardent le cache par défaut et peuvent être remplacés
  <If "%{REQUEST_URI} =~ m#/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|woff2)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/json application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
# llms.txt, robots.txt : texte accentué servi en UTF-8
AddCharset UTF-8 .txt
